// Stump control decode module.
// Behavioural Verilog module describing combinatorial logic.
//
// P W Nutter
//
// April 2019
//
// Update


`include "Stump_definitions.v"

/*----------------------------------------------------------------------------*/

/** 
	!!! DO NOT augment the interface for the Stump_control_decode module      !!!
	!!! Altering the interface could cause compilation and synthesis errors.  !!!
*/
module Stump_control_decode (input  wire [1:0]  state,      // current state of FSM
		             		 input  wire [3:0]  cc,         // current status of cc
              	             input  wire [15:0] ir,	        // current instruction
                             output reg         fetch,
                             output reg         execute,    // current state
                             output reg         memory,
 		             		 output reg         ext_op,		      
 		             		 output reg         reg_write,  // register write enable
		             		 output reg  [2:0]  dest,	    // destination register		      
		             		 output reg  [2:0]  srcA,	    // Source register operand A
		             		 output reg  [2:0]  srcB,	    // Source register operand B
		             		 output reg  [1:0]  shift_op,
              	             output reg         opB_mux_sel,// operandB mux select
		             		 output reg  [2:0]  alu_func,   // function derived from ir
              	             output reg         cc_en,      // cc register enable
                             output reg         mem_ren,    // Memory read enable		      
                             output reg         mem_wen	    // Memory write enable
                     		 );

/* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*/
/* Declarations of any internal signals and buses used                        */
reg [1:0] 	type;   // type 1, type 2, type 3
reg [15:0]	immediate;


/* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*/

/* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*/
/* Control decoder                                                             */
always @ (*) begin
	
	// signals for fetch
	if (state == `FETCH) begin
		fetch       = 1'b1;
		execute   	= 1'b0;
		memory    	= 1'b0;
		ext_op    	= 1'bX;
		reg_write 	= 1'b1;
		dest	  	= 3'b111;
		srcA	 	= 3'b111;
		srcB	 	= 3'bXXX;
		shift_op  	= 2'b00;
		opB_mux_sel = 1'bX; 
		alu_func	= 3'b000;
		cc_en		= 1'bX;
		mem_ren		= 1'b1;
		mem_wen 	= 1'b0;
	end

	// signals for fetch
	else if (state == `EXECUTE) begin
		
		// check for type
		if (ir[15:12] == 4'b1111) type = 2'b11;
		else if (ir[12] == 0)     type = 2'b01;
		else if (ir[12] == 1)	  type = 2'b10;
		else 					  type = 2'bXX;
		
		case (type)
			// type 1 signals
			1: begin
				fetch       = 1'b0;
				execute   	= 1'b1;
				memory    	= 1'b0;
				dest		= ir[10:8];
				srcA		= ir[7:5];
				alu_func	= ir[15:13];
				mem_ren		= 1'b0;
				mem_wen		= 1'b0;
				ext_op	 	= 1'b0;
				srcB 	 	= ir[4:2];
				shift_op 	= ir[1:0];
				opB_mux_sel = 1'b0;
				cc_en 		= cc_en_set(ir[15:13]);
				reg_write 	= reg_write_set(ir[15:13]);
			end
			// type 2 signals
			2 : begin
				fetch       = 1'b0;
				execute   	= 1'b1;
				memory    	= 1'b0;
				dest		= ir[10:8];
				srcA		= ir[7:5];
				alu_func	= ir[15:13];
				mem_ren		= 1'b0;
				mem_wen		= 1'b0;
				ext_op   	= 1'b0;
				srcB 	 	= 3'b000;
				shift_op 	= 2'b00;
				opB_mux_sel = 1'b1;
				cc_en 		= cc_en_set(ir[15:13]);
				reg_write 	= reg_write_set(ir[15:13]);
			end
			// type 3 signals (BCC)
			3 : begin
				fetch       = 1'b0;
				execute   	= 1'b1;
				memory    	= 1'b0;
				ext_op		= 1'b1;
				dest		= 3'b111;
				srcA		= 3'b111;
				srcB		= 3'bXXX;
				shift_op	= 2'b00;
				opB_mux_sel = 1'b1;
				alu_func	= 3'b111;
				cc_en		= 1'b0;
				mem_ren 	= 1'b0;
				mem_wen 	= 1'b0;
				reg_write   = reg_write_branch(ir[11:8], cc);				
			end
			// unknown type, to avoid latch
			default : begin
				fetch       = 1'bX;
				execute   	= 1'bX;
				memory    	= 1'bX;
				dest		= 3'bXXX;
				srcA		= 3'bXXX;
				alu_func	= 3'bXXX;
				mem_ren		= 1'bX;
				mem_wen		= 1'bX;
				ext_op   	= 1'bX;
				srcB 	 	= 3'bXXX;
				shift_op 	= 2'bXX;
				opB_mux_sel = 1'bX;
				cc_en 		= 1'bX;
				reg_write 	= 1'bX;
			end
		endcase
	end 
	
	// signals for memory
	else begin
		// define shared signals
		fetch 		= 1'b0;
		execute 	= 1'b0;
		memory 		= 1'b1;
		ext_op	    = 1'bX;
		srcB 		= 3'bXXX;
		shift_op 	= 2'bXX;
		opB_mux_sel = 1'bX;
		alu_func 	= 3'bXXX;
		cc_en 		= 1'b0;
		
		// load store specific
		case (ir[11]) 
			// load signals
			0 : begin
				reg_write = 1'b1;
				dest 	  = ir[10:8];
				srcA 	  = 3'bXXX;
				mem_ren   = 1'b1;
				mem_wen   = 1'b0;
			end
			// store signals
			1 : begin
				reg_write = 1'b0;
				dest 	  = 3'bX;
				srcA 	  = ir[10:8];
				mem_ren   = 1'b0;
				mem_wen   = 1'b1;
			end
			// unknown signals, to avoid latch
			default : begin
				reg_write = 1'bX;
				dest 	  = 3'bX;
				srcA 	  = 3'bXXX;
				mem_ren   = 1'bX;
				mem_wen   = 1'bX;
			end
		endcase			
	end
end

/* A bunch of functions to reduce code complexity */
// set flags
function cc_en_set;
input [2:0] instr;
begin
	case (instr)
		3'b110 : cc_en_set = 1'b0;
		default : cc_en_set = ir[11];
	endcase
end
endfunction

// set register write for type 1 and 2
function reg_write_set;
input [2:0] instr;
begin
	case (instr)
		3'b110 : reg_write_set = 1'b0;
		default : reg_write_set = 1'b1;
	endcase
end
endfunction

// set register write for type 3
function reg_write_branch;
input [3:0] func;
input [3:0] flags_condition;
begin
	if (Testbranch(func, flags_condition) == 1) reg_write_branch = 1'b1;
	else reg_write_branch = 1'b0;
end
endfunction
/* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*/

/* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -*/
/* Condition evaluation - an example 'function'                               */

function Testbranch; 		// Returns '1' if branch taken, '0' otherwise
input [3:0] condition;		// Condition bits from instruction
input [3:0] CC;				// Current condition code register
reg N, Z, V, C;

begin
  {N,Z,V,C} = CC;			// Break condition code register into flags
  case (condition)
     0 : Testbranch =   1;	// Always (true)
     1 : Testbranch =   0;	// Never (false)
     2 : Testbranch = ~(C|Z);
     3 : Testbranch =   C|Z;
     4 : Testbranch =  ~C;
     5 : Testbranch =   C;
     6 : Testbranch =  ~Z;
     7 : Testbranch =   Z;
     8 : Testbranch =  ~V;
     9 : Testbranch =   V;
    10 : Testbranch =  ~N;
    11 : Testbranch =   N;
    12 : Testbranch =   V~^N;
    13 : Testbranch =   V^N;
    14 : Testbranch = ~((V^N)|Z) ;
    15 : Testbranch =  ((V^N)|Z) ;
  endcase
end
endfunction

/*----------------------------------------------------------------------------*/

endmodule

/*============================================================================*/
